---
// Changelog (/en/changelog): user-visible changes, newest first. Source:
// src/data/changelog.ts (also feeds the RSS feed). For production users (e.g.
// integrations) who want to stay informed about new data sources and behaviour
// changes.
import Docs from "../../layouts/Docs.astro";
import { changelog, KIND_LABEL } from "../../data/changelog";

const entries = [...changelog].sort((a, b) => b.date.localeCompare(a.date));
const fmt = (iso: string) =>
  new Date(iso + "T00:00:00Z").toLocaleDateString("en-GB", {
    day: "2-digit",
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
---

<Docs
  title="Changelog: API changes and new data"
  description="All user-visible changes to the InfraNode API: new data sources, new cities, behaviour changes, fixes and deprecations. Subscribe via RSS."
  current="changelog"
  lang="en"
  altLangPath="/changelog/"
>
  <h1>Changelog</h1>

  <p>
    Every change to the InfraNode API that is relevant to using it: new data
    types, newly covered cities, behaviour changes, fixes and announced
    deprecations. Newest first.
  </p>

  <div class="subscribe">
    <p class="subscribe__title">Stay up to date</p>
    <ul class="subscribe__list">
      <li>
        <a href="/en/changelog/feed.xml">RSS feed</a> of this page (works in any
        feed reader)
      </li>
      <li>
        <a href="https://github.com/street1983nk/infranode/releases" rel="noopener"
          >GitHub releases</a
        > (Watch for release notifications)
      </li>
      <li>
        <a href="https://status.infranode.dev" rel="noopener">Status page</a> for
        availability and ongoing incidents
      </li>
    </ul>
    <p class="subscribe__note">
      Planned and upcoming changes are on the <a href="/en/roadmap/">roadmap</a>.
      Changes affecting existing responses are announced there in advance.
    </p>
  </div>

  <ol class="log" aria-label="Changes">
    {
      entries.map((e) => (
        <li class="log__item">
          <div class="log__meta">
            <time class="log__date" datetime={e.date}>
              {fmt(e.date)}
            </time>
            <span class="log__badge" data-kind={e.kind}>
              {KIND_LABEL[e.kind].en}
            </span>
          </div>
          <div class="log__body">
            <h2 class="log__title">{e.en.title}</h2>
            <p>{e.en.body}</p>
            {e.endpoint && (
              <p class="log__ref">
                Reference: <a href={`/en/api/${e.endpoint}/`}>{e.endpoint}</a>
              </p>
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <p class="log__foot">
    Older changes from before this changelog started are traceable in the
    <a href="https://github.com/street1983nk/infranode/commits/main" rel="noopener"
      >commit history</a
    >.
  </p>
</Docs>

<style>
  .subscribe {
    background: var(--bg-soft);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0 2rem;
  }
  .subscribe__title {
    font-weight: 600;
    margin: 0 0 0.5rem;
  }
  .subscribe__list {
    margin: 0 0 0.5rem;
    padding-left: 1.2rem;
  }
  .subscribe__list li {
    margin: 0.2rem 0;
  }
  .subscribe__note {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: var(--fg-muted);
  }

  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .log__item {
    display: grid;
    grid-template-columns: 12rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }
  /* Grid-Kinder duerfen unter ihre Inhaltsbreite schrumpfen, sonst reisst
     ein langer Code-Token die Spalte auf und die Seite scrollt mobil nach
     rechts (min-width:auto ist der Grid-Default). */
  .log__item > * {
    min-width: 0;
  }
  .log__title,
  .log__body {
    overflow-wrap: break-word;
  }
  .log__body code {
    overflow-wrap: anywhere;
  }
  .log__item:first-child {
    border-top: none;
  }
  .log__meta {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    align-items: flex-start;
  }
  .log__date {
    color: var(--fg-muted);
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .log__badge {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    color: var(--fg);
    background: var(--bg-soft);
  }
  .log__badge[data-kind="added"] {
    color: var(--color-accent-strong);
    background: var(--color-accent-soft);
    border-color: var(--color-accent-soft);
  }
  .log__badge[data-kind="changed"] {
    color: var(--color-primary-strong);
    background: var(--color-primary-soft);
    border-color: var(--color-primary-soft);
  }
  .log__badge[data-kind="deprecated"],
  .log__badge[data-kind="removed"] {
    color: var(--warn-fg);
    background: var(--warn-bg);
    border-color: var(--warn-border);
  }
  .log__title {
    margin: 0 0 0.35rem;
    font-size: 1.15rem;
  }
  .log__body p {
    margin: 0 0 0.35rem;
  }
  .log__ref {
    font-size: 0.92rem;
    color: var(--fg-muted);
  }
  .log__foot {
    margin-top: 2rem;
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .log__item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
    .log__meta {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }
  }
</style>
