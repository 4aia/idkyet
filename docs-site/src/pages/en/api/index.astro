---
// English counterpart of /api/ (see there for the reasoning). Same source, same
// categories, English labels and summaries where the spec provides them
// (summaryEn / x-summary-en); falls back to the German summary so a row is
// never empty.
import { getCollection } from "astro:content";
import Docs from "../../../layouts/Docs.astro";
import JsonLd from "../../../components/JsonLd.astro";
import { CATEGORIES, CATEGORY_OF } from "../../../data/endpoint-categories";
import { NAV_HIDDEN, NAV_LABEL } from "../../../data/endpoint-labels";

const endpoints = await getCollection("endpoints");

type Row = {
  id: string;
  method: string;
  path: string;
  summary: string;
};

const byCat = new Map<string, Row[]>();
for (const entry of endpoints) {
  const e = entry.data;
  if (NAV_HIDDEN.has(e.id)) continue;
  const cat = CATEGORY_OF[e.id] ?? "sonstige";
  if (!byCat.has(cat)) byCat.set(cat, []);
  byCat.get(cat)!.push({
    id: e.id,
    method: e.method.toUpperCase(),
    path: e.path,
    summary: e.summaryEn || NAV_LABEL[e.id]?.en || e.summary || e.id,
  });
}
for (const rows of byCat.values()) {
  rows.sort((a, b) => a.path.localeCompare(b.path, "en"));
}

const shown = CATEGORIES.filter((c) => byCat.has(c.id));
const total = [...byCat.values()].reduce((n, rows) => n + rows.length, 0);

const title = `API reference: all ${total} endpoints`;
const description =
  `Complete index of the InfraNode REST API: ${total} endpoints for 84 major ` +
  `German cities, grouped by topic. Key-free, free of charge, no sign-up.`;
---

<Docs title={title} description={description} lang="en" altLangPath="/api/">
  <JsonLd
    data={{
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      name: "InfraNode API reference",
      description,
      url: "https://infranode.dev/en/api/",
      isPartOf: { "@type": "WebSite", url: "https://infranode.dev/" },
    }}
  />

  <h1>API reference</h1>
  <p>
    The InfraNode API serves open data for 84 major German cities through
    <strong>{total} endpoints</strong>, grouped by topic. Every endpoint has its
    own page with parameters, ready-to-run examples for curl, JavaScript and
    Python, and a try-it console.
  </p>
  <p>
    All endpoints are <strong>key-free</strong> and read-only. Responses always
    follow the same envelope of <code>data</code> and <code>meta</code>; a
    missing upstream yields an honest <code>source_status</code> rather than an
    error. The machine-readable specification lives at
    <a href="/en/api/getOpenApiSpec/">/api/v1/openapi.yaml</a>.
  </p>

  <nav class="api-index__jump" aria-label="Topics">
    <ul>
      {
        shown.map((cat) => (
          <li>
            <a href={`#${cat.id}`}>
              {cat.en} <span class="api-index__count">{byCat.get(cat.id)!.length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  {
    shown.map((cat) => (
      <section class="api-index__cat">
        <h2 id={cat.id}>
          {cat.en} <span class="api-index__count">{byCat.get(cat.id)!.length}</span>
        </h2>
        <table class="api-index__table">
          <thead>
            <tr>
              <th scope="col">Method</th>
              <th scope="col">Path</th>
              <th scope="col">Description</th>
            </tr>
          </thead>
          <tbody>
            {byCat.get(cat.id)!.map((row) => (
              <tr>
                <td><code class="api-index__method">{row.method}</code></td>
                <td>
                  <a href={`/en/api/${row.id}/`}><code>{row.path}</code></a>
                </td>
                <td>{row.summary}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))
  }
</Docs>

<style>
  .api-index__jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
  }
  .api-index__jump a {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border, #e5e7eb);
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.9rem;
  }
  .api-index__count {
    display: inline-block;
    margin-left: 0.35rem;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
    font-size: 0.85em;
  }
  .api-index__cat {
    margin-top: 2.5rem;
  }
  .api-index__table {
    width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
  }
  .api-index__table th,
  .api-index__table td {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--border, #e5e7eb);
    vertical-align: top;
  }
  .api-index__method {
    font-size: 0.8rem;
    opacity: 0.7;
  }
</style>
