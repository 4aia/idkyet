# deploy/Caddyfile.prod - Produktions-Ingress mit Domain + DNS-01-Auto-HTTPS (DEP-01)
# Quelle: caddy-dns/cloudflare README + caddyserver.com/docs/caddyfile/directives/tls [CITED]
# Pitfall: Hinter dem Cloudflare-Proxy (orange cloud) scheitern HTTP-01/TLS-ALPN-Challenges.
# Nur die DNS-01-Challenge (ueber die Cloudflare-API) provisioniert ein public-trusted
# Origin-Cert sauber, sodass Cloudflare auf "Full (strict)" gestellt werden kann.
# Caddy bleibt der EINZIGE Ingress; die api ist nur intern via expose:8000 erreichbar.

# Die nackte Root-Domain gehoert NICHT diesem Projekt (dort laeuft etwas
# anderes) - Caddy claimt hier bewusst nur die mcp.-Subdomain und die
# internen Ops-Subdomains unten. Die REST-API ist rein intern (nur der
# mcp-Service spricht sie an, siehe deploy/docker-compose.yml); es gibt
# keinen oeffentlichen /api/v1-Proxy und keine ausgelieferte Doku-Site mehr.

# Uptime-Kuma Status-Page (Owner 2026-06-13): oeffentliche Stoerungs-/Status-Seite
# fuer Devs, prominent verlinkt von /abdeckung. Eigener Subdomain-Block, damit Kuma
# auf Root laeuft (Status-Pages + Socket.io/WebSocket, von reverse_proxy automatisch
# durchgereicht). Cert via DNS-01 (Cloudflare) wie der Hauptblock. Kuma ist nur
# intern via kuma:3001 erreichbar; Caddy bleibt der EINZIGE Ingress (Gateway-
# Invariante). Das Kuma-Dashboard unter /dashboard ist Login-geschuetzt (starkes
# Admin-Passwort, secrets/SERVER.md); oeffentlich ist nur die Status-Page.
status.{$INFRANODE_PUBLIC_DOMAIN} {
	encode zstd gzip

	tls {
		dns cloudflare {env.INFRANODE_CF_DNS_TOKEN}
		resolvers 1.1.1.1
	}

	reverse_proxy kuma:3001
}

# Remote-MCP-Server (Owner 2026-06-13, full public): oeffentlicher Streamable-
# HTTP-Endpunkt unter mcp.<domain>, keylos wie die API. Eigener Subdomain-Block;
# Endpunkt-Pfad ist /mcp. Der mcp-Service ist nur intern via mcp:8081 erreichbar,
# Caddy bleibt der EINZIGE Ingress (Gateway-Invariante). Cert via DNS-01 wie die
# anderen Bloecke. MCP nutzt JSON-RPC ueber HTTP + SSE; reverse_proxy reicht den
# SSE-Stream automatisch durch (der Server sendet x-accel-buffering:no, was auch
# Cloudflare das Buffern abschaltet).
mcp.{$INFRANODE_PUBLIC_DOMAIN} {
	encode zstd gzip

	tls {
		dns cloudflare {env.INFRANODE_CF_DNS_TOKEN}
		resolvers 1.1.1.1
	}

	# Browser-Zugriff (jemand ruft mcp.<domain> oder mcp.<domain>/mcp im Browser
	# auf statt per MCP-Client zu verbinden): kein oeffentliches Doku-Portal mehr
	# zum Hinschicken, also eine kurze Klartext-Antwort statt eines rohen
	# JSON-RPC-Fehlers (406 "Client must accept text/event-stream"). Echte
	# MCP-Clients senden nie Accept: text/html (nur application/json +
	# text/event-stream), der Matcher unterscheidet also zuverlaessig.
	@browser {
		header Accept *text/html*
		not path /llms.txt
	}
	handle @browser {
		header Content-Type "text/plain; charset=utf-8"
		respond "Atlas MCP server. Connect with an MCP client (streamable HTTP) at /mcp, e.g.: claude mcp add --transport http atlas https://{$INFRANODE_PUBLIC_DOMAIN}/mcp" 200
	}

	# Trailing-Slash-Toleranz (Directory-Review 2026-07-10): /mcp/ intern auf
	# /mcp umschreiben, statt den 307 des Python-Servers durchzureichen.
	# Anthropics Review meidet Redirects auf Protokoll-Endpunkten; der interne
	# Rewrite erhaelt Methode und POST-Body, echte Clients ohne Slash sind
	# unberuehrt.
	rewrite /mcp/ /mcp

	# llms.txt fuer LLM-Crawler auf der MCP-Subdomain. Bewusst ohne Zahlenangaben
	# (Datenarten/Staedte wachsen).
	handle /llms.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<LLMS
			# Atlas MCP Server

			> Remote MCP server (streamable HTTP) for German open data: live and
			> archived data for the largest German cities, from licensed official
			> sources with per-record attribution. Keyless and read-only.

			Endpoint: https://mcp.{$INFRANODE_PUBLIC_DOMAIN}/mcp
			LLMS 200
	}

	# Reine Maschinen-Schnittstelle (JSON-RPC/SSE), keine HTML-Auslieferung -> keine CSP.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	reverse_proxy mcp:8081 {
		# Client-gesendetes X-Forwarded-For strippen (Konsistenz zum API-Block,
		# Audit HIGH-2): der MCP-Rate-Limiter (mcp/ratelimit.py) faellt nach
		# CF-Connecting-IP auf X-Forwarded-For[0] zurueck; ohne Strip koennte ein
		# Client es faelschen und sich frische Schutzfenster erschleichen.
		header_up -X-Forwarded-For
	}
}

# Self-hosted ntfy-Server (OPS-NTFY-SELFHOST, Owner-Entscheid 2026-07-16): eigener
# Ingress fuer den Alarm-Push-Kanal unter ntfy.<domain>, Ersatz fuer die gedrosselte
# ntfy.sh-Free-Tier. Der ntfy-Service ist nur intern via ntfy:80 erreichbar (KEIN
# oeffentliches Port-Mapping); Caddy bleibt der EINZIGE Ingress (Gateway-Invariante).
# Cert via DNS-01 (Cloudflare) wie die anderen Bloecke. ntfy nutzt WebSockets fuer den
# Live-Nachrichten-Stream; reverse_proxy reicht das Upgrade automatisch durch.
# NTFY_AUTH_DEFAULT_ACCESS=deny-all haelt den Server ohne angelegten User/Token dicht.
ntfy.{$INFRANODE_PUBLIC_DOMAIN} {
	encode zstd gzip

	tls {
		dns cloudflare {env.INFRANODE_CF_DNS_TOKEN}
		resolvers 1.1.1.1
	}

	reverse_proxy ntfy:80
}
