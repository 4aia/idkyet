# Atlas API - Beispiel-Umgebungsvariablen
# Kopieren nach .env und Werte einsetzen. .env wird NICHT committet.
# Variablennamen sind camelCase, kein Prefix (Settings.alias_generator).
# KEINE echten Secrets in diese Datei eintragen.

# --- Infrastruktur ---
logLevel=INFO
redisUrl=redis://redis:6379/0
# CORS-Whitelist (JSON-Liste), niemals "*"
corsOrigins=["http://localhost:3000"]

# --- Phase 11: Rate-Limiting + API-Keys (API-06/API-07) ---
# Rate-Limit-Tiers im limits/slowapi-Format "<zahl>/<einheit>". anon = anonymes
# IP-Budget, mint = striktes Budget am Key-Mint-Endpunkt gegen Key-Flooding.
limitAnon=300/minute
limitMint=3/hour
# Rate-Limit je ChatGPT-GPT-Nutzer (ephemere OpenAI-Nutzer-Kennung). Backstop
# fuer die per ratelimitAllowlist vom IP-Limit ausgenommenen
# OpenAI-Egress-Ranges (openai.com/chatgpt-actions.json). Leer = deaktiviert.
limitGpt=480/minute
# Striktes Budget am Admin-Login gegen Brute-Force (Audit HIGH-1).
limitAdminLogin=5/minute
# Sync-Redis-URI fuer slowapis eigene limits-Storage. Leer lassen = Fallback auf
# redisUrl (selber Server, getrennte sync-Verbindung; slowapi teilt
# den async-Pool nicht). Beispiel: redis://redis:6379/0
limitStorageUri=

# --- Phase 13: Admin-Dashboard (OPS-01/OPS-02) ---
# Passwort fuer das Cookie-geschuetzte /admin-Dashboard. Leer lassen = Login
# unmoeglich (fail-closed, kein Zugang). KEIN echtes Secret in diese Datei.
adminPassword=
# Signier-Secret fuer das Session-Cookie (itsdangerous). Mindestens 32 Byte
# Zufall verwenden (z.B. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Leer lassen = keine Session signierbar (fail-closed).
adminSessionSecret=
# Maximale Anzahl der im Redis-Ringpuffer gehaltenen Request-Logs (aelteste werden
# verworfen). Default 200.
adminLogMax=200
# Secure-Flag des Session-Cookies. true = Cookie nur ueber HTTPS (Produktion hinter
# Caddy/Cloudflare). Nur lokal/in Tests ohne TLS auf false setzen.
adminCookieHttpsOnly=true

# --- Quellen-Toggles (true/false): jede Quelle einzeln aktivierbar (FND-02) ---
enableWikidata=true
enableDwd=true
enableOverpass=true
# Overpass-Endpunkt. Default = oeffentliche Instanz (nur fuer leichte Nutzung). Die
# oeffentliche Instanz untersagt Drittnutzer-Backends im Dauerbetrieb (Fair-Use);
# fuer Produktion eigene Instanz (Planet-Dump) oder Geofabrik eintragen.
overpassBaseUrl=https://overpass-api.de/api/interpreter
enableAutobahn=true
enableHvv=false
enableDelfi=false
# Phase 7: Tier-A-Quellen (E-Mobilitaet und erweiterte Umweltdaten),
# alle keylos und bundesweit, daher Default true. enable_lhp = Hochwasser (LHP).
# BNETZA: Toggle steuert nur die /charging-Route (Snapshot-Read); die Daten
# stammen aus einem offline aktualisierten CSV-Datensatz, nicht mehr live.
enableBnetza=true
enableUba=true
enablePegelonline=true
enableLhp=true
enableDwdPollen=true
# Phase 8: account-gated Quellen Default false (Credentials erforderlich):
# GENESIS = Demografie + Krankenhaus (regionalstatistik.de), ZENSUS = Zensus-Host.
# Keylose Bulk-/Seed-Quellen Default true (MaStR-Energie, BKG-Geo, Bundeswahl,
# Feiertage/Ferien).
enableGenesis=false
enableZensus=false
enableMastr=true
enableBkg=true
enableBundeswahl=true
enableHolidays=true
# BKA-PKS Kriminalstatistik je Kreis (Bulk-XLSX, keylos DL-DE/BY, Tier A). Nur
# Toggle, kein Secret; der Ingest probt das juengste Jahr live von www.bka.de.
enableBkaPks=true
# BBK NINA Bevoelkerungsschutz-Warnungen je Stadt (keylos, ARS-basiert, amtliches
# Werk = Tier A, Warntext verbatim). Nur Toggle, kein Secret.
enableBbkNina=true
# Quick-260708-tsv: kommunale Ratsinformationen (council-papers, OParl) der fuenf
# lizenzgeklaerten Staedte. Default FALSE (default-off): erst nach dem ersten
# Batch-Ingest (python -m infranode.ingest.oparl backfill) freischalten. Nur Toggle.
enableCouncil=false
# 5xx-Haeufungs-Alarm: WARNING-Push, wenn die laufende UTC-Stunde mehr als diese
# Zahl Server-Fehler (>=500) zaehlt. 0 = aus. Nur Schwelle, kein Secret.
errors5XxHourlyAlert=100
# Phase 9: keylose Stadt-Verkehrs-Quellen (Baustellen/Sperrungen) je Stadt +
# Autobahn-Webcam-Sub-Service. Alle keylos, daher Default true (analog
# enableAutobahn). Keine neuen Secrets.
enableBerlinViz=true
enableHamburgRoadworks=true
enableKoelnRoadEvents=true
enableMuenchenRoadworks=true
enableMobidataBw=true
enableAutobahnWebcam=true
# Phase 10: Stadt-Events/Veranstaltungen. destination.one ist KEYLOS: die
# Experience "open-data" ist frei zugaenglich (Support-Bestaetigung 2026-06-10),
# daher Default true. koeln_events ist ebenfalls keylos, Default true.
enableDestinationOne=true
enableKoelnEvents=true

# --- API-Keys / Credentials (leer lassen = Quelle nicht nutzbar, Graceful Degradation) ---
# HVV / Geofox (Hamburg): Key per Vereinbarung. Die Geofox-GTI-Auth braucht user +
# api_key (HMAC-Secret); fehlt einer von beiden, liefert die Route disabled.
hvvUser=
hvvApiKey=
# GENESIS / Regionalstatistik (account-gated POST-API). Konto unter
# regionalstatistik.de -> Registrierung/Mein Konto. Hinweis: das Settings-Feld
# heisst genesis_username, mappt also auf genesisUsername (NICHT
# genesisUser). Eine evtl. vorhandene SOURCE_GENESIS_ENABLED-Variable
# ist Legacy und wird NICHT gelesen; nur enableGenesis greift.
genesisUsername=
genesisPassword=
# Regionalstatistik.de GENESIS-Webservice (DATA-37: Realsteuer-Hebesaetze 71231 +
# Gewerbean-/-abmeldungen 52311). Header-Auth username/password, NUR im Bulk-Ingest
# (python -m infranode.ingest.regionalstatistik), NIE im Request-Pfad. Ohne diese
# Credentials liefern /tax-rates + /business-registrations 200 disabled.
regioUser=
regioPass=
# DB-API-Marketplace (Deutsche Bahn): gemeinsame Credentials der DB-Marketplace-
# Anwendung fuer Timetables/StaDa/FaSta. Ein Client-ID/Key-Paar deckt alle drei
# Produkte ab. Ohne diese Credentials liefern die betroffenen Routen 200 disabled
# (Graceful Degradation), der Abruf bleibt dann einfach aus.
dbClientId=
dbApiKey=
# Tankerkoenig / MTS-K (Spritpreise, DATA-30). Ohne Key liefert /fuel-prices 200
# disabled. Live-only Zugriff (kein Vorhalten laut ToS).
tankerkoenigKey=
# Zensus (ergebnisse.zensus2022.de): evtl. getrennter Account (RESEARCH A4).
zensusUser=
zensusPassword=
# RMV HAPI (Rhein-Main, Frankfurt): accessId-Auth, https://www.rmv.de/hapi/.
# Open Data, aber KEIN GTFS (nur Haltestellen-Datei opendata.rmv.de). Tier/Lizenz
# VOR produktiver Nutzung pruefen (vermutlich Tier C live-only, wie HVV/geofox).
# API-Migration auf v2.52.0 zum 2026-09-22 (Testumgebung https://www.rmv.de/hapi/latest/).
rmvAccessId=
# destination.one / eT4.META (Stadt-Events, Phase 10): KEIN Key noetig, die
# Experience "open-data" ist frei zugaenglich (verifiziert 2026-06-10).

# --- Lokales Datenverzeichnis ---
# Wurzelpfad des lokalen Datenverzeichnisses (Feld-/Env-Name aus
# Kompatibilitaetsgruenden unveraendert).
# In Docker als Volume gemountet (deploy/docker-compose.yml).
# archiveDir=data/archive

# --- Operative Hinweise fuer spaetere Phasen (noch nicht von Settings gelesen) ---
# Pflicht-kontaktierbarer User-Agent fuer Wikidata/Overpass/DWD (Fair-Use), ab Phase 3/4
# httpUserAgent=Atlas/0.1 (+https://github.com/4aia/idkyet; contact@example.com)
# DELFI / opendata-oepnv.de: kein Laufzeit-Key, GTFS-ZIP-Pfad/URL, ab Phase 6
# delfiGtfsPath=./data/delfi/gtfs.zip
# Phase 8: lokale Bulk-Datei-Pfade fuer die Offline-Aufbereitung, nie im
# Request-Pfad. None/unset = Aufbereitung nicht lauffaehig.
# mastrZipPath=./data/mastr/Gesamtdatenexport.zip
# bkgPath=./data/bkg/vg250.geojson
# bundeswahlCsvPath=./data/bundeswahl/kerg2.csv

# --- Mobilithek M2M (DATEX-II V2 Pull, mutual TLS, Port 8443) ---
# Maschinenkonto-Zertifikat (.p12) der Org, ein Cert fuer ALLE abonnierten Mobilithek-Angebote.
# Beziehbar via Mobilithek-Portal -> Meine Organisation -> Maschinenkonten -> "Zertifikat beantragen".
# Datei gitignored unter secrets/ ablegen (NICHT committen), Passwort nur in .env.
mobilithekCertPath=secrets/mobilithek-<name>.p12
mobilithekCertPassword=
# eRound-Abos (DATA-42 Live-Ladebelegung): dynamisch (Belegungs-Deltas, Poller)
# + statisch (Standort-Vollbestand ~94 MB, taeglicher Geo-Map-Ingest).
# eroundChargingAboId=
# eroundLocationsAboId=
# Koeln Parkdaten (quick-260723-gaq): ZWEI Abos (dynamisch = Belegung, statisch = Stammdaten).
# koelnParkingAboId=
# koelnParkingStaticAboId=
# Ablage der Geo-Map im Daten-Volume (Default passt fuer Compose-Prod).
# eroundGeoMapPath=data/eround/eround_geo_map.json

# --- Phase 14: Hetzner-Deployment + Cloudflare (DEP-01/DEP-02) ---
# Cloudflare-API-Token fuer Caddys DNS-01-Challenge (Auto-HTTPS in Prod). Scope
# minimal halten: Zone.Zone:Read + Zone.DNS:Edit, NUR fuer die Zone woof.systems.
# Dieses Token wird AUSSCHLIESSLICH von Caddy via {env....}-Referenz im Caddyfile
# gelesen, NICHT von den Pydantic-Settings der App. Leer lassen im Repo, niemals
# ein echtes Token committen (gitleaks-CI faengt versehentliche Secrets, FND-07).
cfDnsToken=
# Domain fuer die mcp.-Subdomain (Caddy-Site-Block); die nackte Domain
# gehoert nicht diesem Projekt.
publicDomain=woof.systems

# --- Phase 16: Monitoring/Alarmierung/Selbstheilung (OPS-06/07/08) ---
# ntfy-Push-Kanal fuer Alarme. ntfyUrl = Basis-URL des ntfy-Servers
# (self-hosted oder https://ntfy.sh). ntfyTopic ist faktisch ein
# Passwort (nur a-z/0-9/_/- verwenden, nicht erraten lassen). ntfyToken
# = Bearer-Zugriffstoken. Alle drei nur via .env, nie ins Repo (KEIN echtes Secret).
# Self-hosted-Variante (OPS-NTFY-SELFHOST, Owner-Entscheid 2026-07-16): fuer den
# eigenen ntfy-Server ntfyUrl=https://ntfy.woof.systems setzen und
# ntfyToken auf das per `ntfy token add` erzeugte Zugriffstoken (Box-
# Einrichtung siehe docs/DEPLOYMENT.md Abschnitt 12.5).
ntfyUrl=
ntfyTopic=
ntfyToken=
# SMTP-E-Mail-Backup-Kanal. smtpSsl=false = STARTTLS auf Port 587
# (Default), true = SMTP_SSL auf Port 465. smtpPassword nur via .env,
# nie ins Repo (KEIN echtes Secret). Leer lassen = E-Mail-Backup deaktiviert.
smtpHost=
smtpPort=587
smtpUser=
smtpPassword=
smtpFrom=
smtpTo=
smtpSsl=false
# Dead-Man-Ping je Timer-Job (Kuma-Push- bzw. Healthchecks.io-Ping-URL). Wird per
# systemd-Drop-in je Job ueberschrieben. Leer lassen = kein Ping. URL traegt ein
# Token/UUID und ist wie ein Secret zu behandeln (nur via .env, nie ins Repo).
deadmanUrl=
# Externer Box-Liveness-Ping (Finding 8): der Watchdog pingt diese URL am Ende
# jedes erfolgreichen Laufs. Die URL traegt eine UUID und ist wie ein Secret zu
# behandeln (nur via .env, nie ins Repo, analog DEADMAN_URL; HTTPS-Ziel).
healthchecksUrl=
# Self-Heal-Reprobe (A, 2026-06-14): opt-in-Liste BEWUSST per enable_*-Toggle
# deaktivierter Quellen, deren Upstream der Watchdog periodisch direkt anprobt.
# Lebt der Upstream wieder, kommt genau ein "X reaktivierbar"-ntfy (Reaktivierung
# bleibt manuell). Format komma-separiert: source=ProbeURL,source2=ProbeURL2.
# Beispiel: hamburg_traffic_situation=https://api.hamburg.de/datasets/v1/verkehrslage/collections/verkehrslage/items?f=json&limit=1
# Leer = aus. (Enabled gelassene Quellen heilen ohnehin ueber den persistenten
# Breaker mit Per-Source-Cooldown, kein Eintrag noetig.)
selfhealProbes=

# Kapazitaets-/Saettigungs-Fruehwarnung: der Watchdog warnt per WARNING-Push,
# BEVOR die eine API-Replica saturiert (Stufe 1: nur Alarm, kein Auto-Scaling).
# Bewusst konservative Defaults (Fruehwarnung, kein Kapazitaetsregler):
#   capacityLoadPerCoreWarn  1-min-Last pro Kern (Kopf-Reserve auf der 8-vCPU-Box)
#   capacityRedisMemWarn      Redis-Speicheranteil used_memory/maxmemory (0 = Signal aus)
#   capacityHysteresisTicks    aufeinanderfolgende Ueberschreitungen bis zum Alarm (gegen Flapping)
capacityLoadPerCoreWarn=0.75
capacityRedisMemWarn=0.80
capacityHysteresisTicks=2

# --- MCP-/Redis-Connection-Backpressure ---
# Drei defensive Deckel gegen Connection-Pool-Exhaustion. Rein defensiv: im
# Normalbetrieb aendert sich NICHTS (die Defaults spiegeln die bisherigen
# effektiven Werte), nur bei Ueberlast greifen die Deckel. Die stateless_http-
# Umstellung des MCP-Servers ist bewusst NICHT Teil davon.
#   mcpLimitConcurrency        einziger echter neuer Deckel: max. gleichzeitige MCP-Sessions, jenseits davon liefert uvicorn 503 (vorher unbegrenzt)
#   mcpTimeoutKeepAlive       uvicorn keep-alive in Sekunden (= uvicorn-Default, nur explizit)
#   mcpBacklog                  uvicorn TCP-Backlog (= uvicorn-Default, nur explizit)
#   redisMaxConnections        Deckel des Redis-Pools gegen unbegrenztes Socket-Wachstum (vorher unbegrenzt)
#   mcpLoopbackMaxConnections max. Verbindungen des MCP-Loopback-httpx-Clients (= httpx-Default)
#   mcpLoopbackMaxKeepalive   max. keep-alive-Verbindungen des Loopback-Clients (= httpx-Default)
#   mcpLoopbackPoolTimeout    KURZER Pool-Acquire-Deckel des Loopback-Clients in Sekunden (vorher 30s)
#   mcpLoopbackReadTimeout    Read-Timeout des Loopback-Clients in Sekunden (bewusst grosszuegig, langsame Upstreams)
mcpLimitConcurrency=256
mcpTimeoutKeepAlive=5
mcpBacklog=2048
redisMaxConnections=150
mcpLoopbackMaxConnections=100
mcpLoopbackMaxKeepalive=20
mcpLoopbackPoolTimeout=1.0
mcpLoopbackReadTimeout=30.0

# --- Prod-PFLICHT-Hinweis (vor dem Public-Launch zwingend setzen) ---
# Die folgenden bereits oben definierten Variablen MUESSEN in Produktion echte
# Werte tragen, sonst ist der Betrieb unsicher oder fail-closed (kein Zugang):
#   adminPassword         - ohne Wert ist /admin-Login unmoeglich
#   adminSessionSecret   - ohne Wert keine Session signierbar
#       beide mit `python -c "import secrets; print(secrets.token_hex(32))"` erzeugen
#   adminCookieHttpsOnly=true  - in Prod Pflicht (Cookie nur ueber HTTPS)
#   corsOrigins           - die API ist rein intern (nur der mcp-Service
#       ruft sie auf); leer/eng lassen, NIEMALS "*".
